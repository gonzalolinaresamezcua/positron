APP_NAME=POSITROM
APP_ENV=production
APP_DEBUG=0
APP_URL=https://positrom.com
APP_KEY=change_this_to_a_long_random_string
APP_LOCALE=es

# Document root de Plesk debe apuntar a /public
DB_HOST=localhost
DB_PORT=3306
# DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_NAME=positrom
DB_USER=positrom
DB_PASS=cambiar

# Placeholder — no uses claves reales en el repositorio
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOLLIE_API_BASE=https://api.mollie.com/v2

# Cursor: modelo composer-2.5. Base URL configurable (API o pasarela compatible).
CURSOR_API_KEY=crsr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CURSOR_API_BASE=https://api.cursor.com
CURSOR_MODEL=composer-2.5
CURSOR_CHAT_PATH=/v1/chat/completions

PLAN_PRICE_EUR=12.00
PLAN_INTERVAL=1 month
MONTHLY_BUDGET_EUR=12.00
TOKEN_INPUT_COST_EUR_PER_1M=0.50
TOKEN_OUTPUT_COST_EUR_PER_1M=2.50
MONTHLY_TOKEN_ALLOWANCE=
AUTO_ACTIVATE_ON_PAYMENT=1
REMINDER_DAYS_BEFORE=3

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@positrom.com
SMTP_FROM_NAME=POSITROM
SMTP_ENCRYPTION=tls

SESSION_NAME=positrom_sess
CHAT_RATE_PER_MINUTE=30
