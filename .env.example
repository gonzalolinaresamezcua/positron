APP_NAME=POSITROM
APP_ENV=production
APP_DEBUG=0
APP_URL=https://positrom.com
APP_KEY=change_this_to_a_long_random_string
APP_LOCALE=es

# Document root de Plesk debe apuntar a /public
DB_HOST=localhost
DB_PORT=3306
# DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_NAME=positrom
DB_USER=positrom
DB_PASS=cambiar

# OpenAI — obligatorio para el chat (quien despliega aporta su clave)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.openai.com
OPENAI_MODEL=gpt-6-astra
OPENAI_CHAT_PATH=/v1/chat/completions

# Estadísticas de coste y tope opcional de tokens (vacío = sin tope)
TOKEN_INPUT_COST_EUR_PER_1M=0.50
TOKEN_OUTPUT_COST_EUR_PER_1M=2.50
MONTHLY_TOKEN_ALLOWANCE=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@positrom.com
SMTP_FROM_NAME=POSITROM
SMTP_ENCRYPTION=tls

SESSION_NAME=positrom_sess
CHAT_RATE_PER_MINUTE=30
